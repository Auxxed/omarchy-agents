#!/usr/bin/bash
# Launch the named coding agent without changing Omarchy's default.
# Permission-skip flags are intentionally omitted: a marketplace plugin
# must not start a tool-capable agent in auto-approve mode.

set -euo pipefail

id="${1:-}"

LAUNCH_TUI=/usr/bin/omarchy-launch-tui

# Hermes installs per user; prefer the fixed install locations over PATH.
hermes_bin() {
  local candidate
  for candidate in "$HOME/.local/bin/hermes" /usr/bin/hermes; do
    [[ -x $candidate && ! -d $candidate ]] && { printf '%s' "$candidate"; return 0; }
  done
  return 1
}

case "$id" in
hermes-session)
  # hermes-session <session-id> <source>: desktop sessions reopen in the
  # app through its hermes://open/<id> route, everything else resumes in a
  # terminal. Ids come from the collector record, so re-check the shape here.
  sid="${2:-}"
  source="${3:-cli}"
  [[ $sid =~ ^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$ ]] || exit 2
  if [[ $source == desktop && -x /usr/bin/hermes-desktop ]]; then
    exec /usr/bin/uwsm-app -- /usr/bin/hermes-desktop "hermes://open/$sid" </dev/null >/dev/null 2>&1
  fi
  bin=$(hermes_bin) || exit 1
  [[ ${PWD:-} == "${HOME:-}" && -d $HOME/Work ]] && cd "$HOME/Work"
  exec "$LAUNCH_TUI" --app-id=org.omarchy.agent "$bin" --resume "$sid"
  ;;
hermes-pause | hermes-unpause)
  # Hermes' own emergency stop: holds cron, kanban and new gateway turns;
  # in-flight work keeps running.
  bin=$(hermes_bin) || exit 1
  if [[ $id == hermes-pause ]]; then
    exec "$bin" pause --reason "Paused from the Omarchy bar"
  fi
  exec "$bin" resume
  ;;
claude | codex | grok | grok-bot | opencode | gemini | copilot | crush | openclaw | cursor-agent | hermes | hermes-desktop | muse | omp | pi) ;;
*)
  exec /usr/bin/omarchy-agent --pick
  ;;
esac

# Focus a desktop app by its exact window class, or start it. Not
# omarchy-launch-or-focus: that also matches window titles, so a terminal
# or browser tab with "Hermes" in its title would be focused instead.
focus_or_launch() {
  local class=$1
  shift
  local address
  address=$(/usr/bin/hyprctl clients -j 2>/dev/null |
    /usr/bin/jq -r --arg c "$class" 'first(.[] | select(.class == $c) | .address) // empty' 2>/dev/null)
  if [[ $address =~ ^0x[0-9a-f]{1,16}$ ]]; then
    /usr/bin/hyprctl dispatch "hl.dsp.focus({ window = \"address:$address\" })" >/dev/null 2>&1 ||
      /usr/bin/hyprctl dispatch focuswindow "address:$address" >/dev/null
    exit 0
  fi
  exec /usr/bin/setsid /usr/bin/uwsm-app -- "$@" </dev/null >/dev/null 2>&1
}

if [[ $id == grok-bot ]]; then
  focus_or_launch "Grok Bot" grok-bot
fi
if [[ $id == hermes-desktop ]]; then
  focus_or_launch "Hermes" /usr/bin/hermes-desktop
fi

[[ ${PWD:-} == "${HOME:-}" && -d $HOME/Work ]] && cd "$HOME/Work"

case "$id" in
opencode) command=(opencode) ;;
gemini) command=(gemini) ;;
copilot) command=(copilot) ;;
crush) command=(crush) ;;
claude) command=(claude) ;;
grok) command=(grok) ;;
openclaw) command=(omarchy-launch-openclaw --tui) ;;
codex) command=(codex) ;;
cursor-agent) command=(cursor-agent) ;;
hermes) command=(hermes) ;;
muse) command=(muse) ;;
omp) command=(omp) ;;
pi) command=(pi) ;;
*)
  exec /usr/bin/omarchy-agent --pick
  ;;
esac

exec "$LAUNCH_TUI" --app-id=org.omarchy.agent "${command[@]}"
