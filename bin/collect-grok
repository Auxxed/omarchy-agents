#!/usr/bin/python3 -I
# omarchy:summary=Print the Grok usage record as JSON
# omarchy:args=[--force] [--limits-only]
# omarchy:hidden=true
"""Collect Grok Build usage into the same JSON record the agents panel uses for Claude.

Local stats come from billed turn_completed rows in $GROK_HOME/sessions.
Limits and plan come from the SuperGrok CLI-proxy billing endpoint, using the
already-signed-in grok.com OIDC token in ~/.grok/auth.json. The token is only
sent in an HTTP header; this command never writes credentials.
"""

from __future__ import annotations

import argparse
import datetime as dt
import fcntl
import hashlib
import json
import os
import stat
import sys
import tempfile
import time
import urllib.error
import urllib.parse
import urllib.request
from pathlib import Path
from typing import Any

AGENT_ID = "grok"
AGENT_NAME = "Grok"
AUTH_HELP = "Run `grok login` to restore authoritative usage."
BILLING_HOST = "cli-chat-proxy.grok.com"
BILLING_URL = "https://cli-chat-proxy.grok.com/v1/billing?format=credits"
USER_URL = "https://cli-chat-proxy.grok.com/v1/user?include=subscription"
TOKEN_AUTH = "xai-grok-cli"
MAX_AUTH_BYTES = 65536
MAX_HTTP_BYTES = 1_048_576
HTTP_TIMEOUT = 12
PROBE_MIN_INTERVAL_SECONDS = 15
MAX_CACHE_BYTES = 1_048_576
MAX_SUMMARY_BYTES = 65536
# A turn_completed row is small; a longer line is tool output and skipped.
MAX_LINE_BYTES = 1_048_576
# After an HTTP 429 the billing host is left alone this long, or for its
# Retry-After when that is longer (capped at an hour).
RATE_LIMIT_SECONDS = 300
MAX_RATE_LIMIT_SECONDS = 3600

PLAN_LABELS = {
    "GrokPro": "SuperGrok",
    "SuperGrok": "SuperGrok",
    "SuperGrokPro": "SuperGrok",
    "SuperGrokPlus": "SuperGrok Plus",
    "SuperGrokHeavy": "SuperGrok Heavy",
    "GrokHeavy": "SuperGrok Heavy",
}

PRODUCT_TITLES = {
    "GrokBuild": "Grok Build",
    "GrokChat": "Chat",
    "Chat": "Chat",
    "GrokImagine": "Imagine",
    "Imagine": "Imagine",
    "GrokVoice": "Voice",
    "Voice": "Voice",
}
PRODUCT_ORDER = ("Grok Build", "Chat", "Imagine", "Voice")


def expand_path(value: str) -> Path:
    return Path(os.path.expandvars(os.path.expanduser(value))).resolve()


def grok_home() -> Path:
    return expand_path(os.environ.get("GROK_HOME") or "~/.grok")


def cache_root() -> Path:
    """The shared agent-usage cache, 0700. A link or someone else's directory
    at that path is refused rather than written through."""
    base = os.environ.get("XDG_CACHE_HOME") or os.path.join(os.path.expanduser("~"), ".cache")
    root = os.path.join(base, "omarchy", "agent-usage")
    os.makedirs(root, mode=0o700, exist_ok=True)
    st = os.lstat(root)
    if not stat.S_ISDIR(st.st_mode) or st.st_uid != os.geteuid():
        raise PermissionError(f"{root} is not a private directory")
    if st.st_mode & 0o077:
        os.chmod(root, 0o700)
    return Path(root)


def date_string(value: dt.date | None = None) -> str:
    return (value or dt.datetime.now().date()).strftime("%Y-%m-%d")


def recent_date_strings() -> list[str]:
    today = dt.datetime.now().date()
    return [date_string(today - dt.timedelta(days=offset)) for offset in range(6, -1, -1)]


def number(value: Any) -> int:
    try:
        n = float(value or 0)
        return round(n) if n == n else 0
    except Exception:
        return 0


def local_date_from_timestamp(value: Any) -> str:
    if value is None or value == "":
        return date_string()
    if isinstance(value, (int, float)):
        try:
            seconds = float(value) / 1000.0 if float(value) > 10_000_000_000 else float(value)
            return date_string(dt.datetime.fromtimestamp(seconds).date())
        except Exception:
            return date_string()
    raw = str(value).strip()
    try:
        parsed = dt.datetime.fromisoformat(raw.replace("Z", "+00:00"))
        if parsed.tzinfo is not None:
            parsed = parsed.astimezone()
        return date_string(parsed.date())
    except Exception:
        return date_string()


def empty_bucket() -> dict[str, int]:
    return {
        "inputTokens": 0,
        "outputTokens": 0,
        "cacheReadInputTokens": 0,
        "cacheCreationInputTokens": 0,
    }


def empty_stats() -> dict[str, Any]:
    recent_dates = recent_date_strings()
    return {
        "todayPrompts": 0,
        "todaySessions": 0,
        "todayTotalTokens": 0,
        "todayTokensByModel": {},
        "recentDays": [{"date": day, "messageCount": 0} for day in recent_dates],
        "modelUsage": {},
        "totalPrompts": 0,
        "totalSessions": 0,
        "activeDays": 0,
        "activeDates": [],
    }


def open_regular(path: Path) -> tuple[int, os.stat_result] | None:
    """A read-only descriptor for a regular file of ours at path, or None.
    Never follows a final link and never blocks on a FIFO."""
    try:
        fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK | os.O_CLOEXEC)
    except OSError:
        return None
    try:
        st = os.fstat(fd)
        if not stat.S_ISREG(st.st_mode) or st.st_uid != os.geteuid() or st.st_nlink != 1:
            os.close(fd)
            return None
        os.set_blocking(fd, True)
        return fd, st
    except OSError:
        os.close(fd)
        return None


def read_bounded(path: Path, max_bytes: int) -> tuple[bytes, os.stat_result] | None:
    opened = open_regular(path)
    if opened is None:
        return None
    fd, st = opened
    try:
        if st.st_size > max_bytes:
            return None
        data = b""
        while len(data) <= max_bytes:
            chunk = os.read(fd, min(65536, max_bytes + 1 - len(data)))
            if not chunk:
                break
            data += chunk
        return (data, st) if len(data) <= max_bytes else None
    except OSError:
        return None
    finally:
        os.close(fd)


def read_bounded_json(path: Path, max_bytes: int) -> dict[str, Any] | None:
    read = read_bounded(path, max_bytes)
    if read is None:
        return None
    try:
        parsed = json.loads(read[0].decode("utf-8"))
    except (ValueError, RecursionError):
        return None
    return parsed if isinstance(parsed, dict) else None


def bounded_lines(fd: int, max_line: int):
    """Lines of the open file, each at most max_line bytes; longer lines are
    skipped whole without ever being held in memory."""
    buf = b""
    skipping = False
    while True:
        chunk = os.read(fd, 65536)
        if not chunk:
            if buf and not skipping:
                yield buf
            return
        buf += chunk
        while True:
            nl = buf.find(b"\n")
            if nl < 0:
                if len(buf) > max_line:
                    buf = b""
                    skipping = True
                break
            line, buf = buf[:nl], buf[nl + 1:]
            if skipping:
                skipping = False
                continue
            if len(line) <= max_line:
                yield line


def session_kind(session_dir: Path) -> str:
    summary = read_bounded_json(session_dir / "summary.json", MAX_SUMMARY_BYTES) or {}
    return str(summary.get("session_kind") or "")


def is_subagent(kind: str) -> bool:
    return kind.startswith("subagent")


def turn_usage(usage: dict[str, Any]) -> tuple[int, int, int, int]:
    cache_read = number(usage.get("cachedReadTokens", usage.get("cacheReadInputTokens")))
    cache_write = number(
        usage.get("cacheCreationTokens", usage.get("cacheCreationInputTokens", usage.get("cachedWriteTokens")))
    )
    input_tokens = number(usage.get("inputTokens", usage.get("input_tokens")))
    output_tokens = number(usage.get("outputTokens", usage.get("output_tokens")))
    reasoning = number(usage.get("reasoningTokens", usage.get("reasoning_tokens")))
    input_tokens = max(0, input_tokens - cache_read - cache_write)
    if reasoning > output_tokens:
        output_tokens = reasoning
    return input_tokens, output_tokens, cache_read, cache_write


def model_turns(usage: dict[str, Any]) -> list[tuple[str, dict[str, Any]]]:
    models = usage.get("modelUsage")
    if isinstance(models, dict) and models:
        rows = []
        for name, bucket in models.items():
            if isinstance(bucket, dict):
                rows.append((str(name or "grok"), bucket))
        if rows:
            return rows
    return [("grok", usage)]


def extract_usage(update: dict[str, Any]) -> dict[str, Any] | None:
    nested = update.get("usage")
    if isinstance(nested, dict) and nested:
        return nested
    if any(key in update for key in ("inputTokens", "outputTokens", "cachedReadTokens", "cacheCreationTokens")):
        return update
    return None


def scan_updates(path: Path) -> list[dict[str, Any]]:
    turns: list[dict[str, Any]] = []
    seen: set[str] = set()
    opened = open_regular(path)
    if opened is None:
        return turns
    fd, _st = opened
    try:
        for line_number, raw_line in enumerate(bounded_lines(fd, MAX_LINE_BYTES), 1):
            if b"turn_completed" not in raw_line:
                continue
            line = raw_line.decode("utf-8", errors="replace")
            try:
                entry = json.loads(line)
            except Exception:
                continue
            if not isinstance(entry, dict):
                continue
            params = entry.get("params")
            if not isinstance(params, dict):
                continue
            update = params.get("update") or {}
            if not isinstance(update, dict):
                continue
            kind = update.get("sessionUpdate") or update.get("event_name")
            if kind != "turn_completed":
                continue
            usage = extract_usage(update)
            if usage is None:
                continue
            prompt_id = str(update.get("prompt_id") or f"{path}:{line_number}")
            if prompt_id.startswith("task-completed") or prompt_id in seen:
                continue
            seen.add(prompt_id)
            meta = params.get("_meta") if isinstance(params.get("_meta"), dict) else {}
            day = local_date_from_timestamp(entry.get("timestamp") or meta.get("agentTimestampMs"))
            for model, bucket in model_turns(usage):
                input_tokens, output_tokens, cache_read, cache_write = turn_usage(bucket)
                if not (input_tokens or output_tokens or cache_read or cache_write):
                    continue
                turns.append({
                    "id": prompt_id,
                    "day": day,
                    "model": model,
                    "inputTokens": input_tokens,
                    "outputTokens": output_tokens,
                    "cacheReadInputTokens": cache_read,
                    "cacheCreationInputTokens": cache_write,
                })
    except OSError as exc:
        print(f"Ignoring unreadable Grok updates file {path}: {exc}", file=sys.stderr)
    finally:
        os.close(fd)
    return turns


def scan_sessions(sessions_root: Path) -> dict[str, Any]:
    today = date_string()
    recent_dates = recent_date_strings()
    recent = {day: 0 for day in recent_dates}
    stats = empty_stats()
    stats["recentDays"] = [{"date": day, "messageCount": 0} for day in recent_dates]

    if not sessions_root.is_dir():
        return stats

    sessions: set[str] = set()
    today_sessions: set[str] = set()
    active_days: set[str] = set()
    counted: set[tuple[str, str]] = set()
    prompts = 0
    today_prompts = 0
    today_total = 0

    try:
        walker = sessions_root.rglob("updates.jsonl")
    except TypeError:
        walker = sessions_root.rglob("updates.jsonl")

    for path in walker:
        if path.is_symlink():
            continue
        session_dir = path.parent
        if is_subagent(session_kind(session_dir)):
            continue
        session_key = session_dir.name
        for turn in scan_updates(path):
            prompt_id = str(turn.get("id") or "")
            dedupe = (session_key, prompt_id)
            new_prompt = not (prompt_id and dedupe in counted)
            if prompt_id and new_prompt:
                counted.add(dedupe)
            day = str(turn.get("day") or today)
            model = str(turn.get("model") or "grok")
            input_tokens = number(turn.get("inputTokens"))
            output_tokens = number(turn.get("outputTokens"))
            cache_read = number(turn.get("cacheReadInputTokens"))
            cache_write = number(turn.get("cacheCreationInputTokens"))
            total = input_tokens + output_tokens + cache_read + cache_write
            if total <= 0:
                continue
            if new_prompt:
                prompts += 1
            sessions.add(session_key)
            active_days.add(day)
            bucket = stats["modelUsage"].setdefault(model, empty_bucket())
            bucket["inputTokens"] += input_tokens
            bucket["outputTokens"] += output_tokens
            bucket["cacheReadInputTokens"] += cache_read
            bucket["cacheCreationInputTokens"] += cache_write
            if day in recent:
                recent[day] += total
            if day == today:
                if new_prompt:
                    today_prompts += 1
                today_total += total
                stats["todayTokensByModel"][model] = stats["todayTokensByModel"].get(model, 0) + total
                today_sessions.add(session_key)

    stats["todayPrompts"] = today_prompts
    stats["todaySessions"] = len(today_sessions)
    stats["todayTotalTokens"] = today_total
    stats["totalPrompts"] = prompts
    stats["totalSessions"] = len(sessions)
    stats["activeDays"] = len(active_days)
    stats["activeDates"] = sorted(active_days)
    stats["recentDays"] = [{"date": day, "messageCount": recent[day]} for day in recent_dates]
    return stats


def scan_cache_paths(sessions_root: Path) -> tuple[Path, Path]:
    digest = hashlib.sha1(str(sessions_root).encode("utf-8")).hexdigest()[:16]
    root = cache_root()
    return root / f"grok-scan-{digest}.json", root / f"grok-scan-{digest}.lock"


def read_fresh_scan(path: Path, max_age_seconds: float) -> dict[str, Any] | None:
    if max_age_seconds <= 0:
        return None
    read = read_bounded(path, MAX_CACHE_BYTES)
    if read is None:
        return None
    data, st = read
    if not (0 <= time.time() - st.st_mtime <= max_age_seconds):
        return None
    try:
        cached = json.loads(data.decode("utf-8"))
    except (ValueError, RecursionError):
        return None
    if not isinstance(cached, dict) or cached.get("scanDate") != date_string():
        return None
    stats = cached.get("stats")
    return stats if isinstance(stats, dict) else None


def write_json(path: Path, payload: dict[str, Any]) -> None:
    """Atomically replace path with payload, 0600 from the first byte. The
    rename replaces a link planted at path instead of writing through it."""
    handle_fd, tmp_name = tempfile.mkstemp(dir=path.parent, prefix="." + path.name + ".", suffix=".tmp")
    try:
        os.fchmod(handle_fd, 0o600)
        with os.fdopen(handle_fd, "w", encoding="utf-8") as handle:
            handle.write(json.dumps(payload, separators=(",", ":"), sort_keys=True) + "\n")
            handle.flush()
            os.fsync(handle.fileno())
        os.replace(tmp_name, path)
    except BaseException:
        try:
            os.unlink(tmp_name)
        except OSError:
            pass
        raise


def open_lock(path: Path) -> int:
    """The lock file, opened without truncating or following a link."""
    fd = os.open(path, os.O_RDWR | os.O_CREAT | os.O_NOFOLLOW | os.O_NONBLOCK | os.O_CLOEXEC, 0o600)
    st = os.fstat(fd)
    if not stat.S_ISREG(st.st_mode) or st.st_uid != os.geteuid():
        os.close(fd)
        raise PermissionError(f"{path} is not a lock file of ours")
    return fd


def cached_scan(sessions_root: Path, max_age_seconds: float) -> dict[str, Any]:
    try:
        cache_file, lock_file = scan_cache_paths(sessions_root)
    except OSError as exc:
        print(f"omarchy-agent-usage-grok: cache unavailable ({exc}); scanning directly", file=sys.stderr)
        return scan_sessions(sessions_root)
    cached = read_fresh_scan(cache_file, max_age_seconds)
    if cached is not None:
        return cached
    try:
        lock = open_lock(lock_file)
    except OSError as exc:
        print(f"omarchy-agent-usage-grok: cache unavailable ({exc}); scanning directly", file=sys.stderr)
        return scan_sessions(sessions_root)
    try:
        fcntl.flock(lock, fcntl.LOCK_EX)
        cached = read_fresh_scan(cache_file, max_age_seconds)
        if cached is not None:
            return cached
        summary = scan_sessions(sessions_root)
        try:
            write_json(cache_file, {"scanDate": date_string(), "stats": summary})
        except OSError as exc:
            print(f"omarchy-agent-usage-grok: scan cache not written ({exc})", file=sys.stderr)
        return summary
    finally:
        os.close(lock)


class SameOriginRedirectHandler(urllib.request.HTTPRedirectHandler):
    def redirect_request(self, req, fp, code, msg, headers, newurl):
        parsed = urllib.parse.urlparse(newurl)
        if parsed.scheme != "https" or parsed.hostname != BILLING_HOST:
            raise urllib.error.HTTPError(newurl, code, "cross-origin redirect refused", headers, fp)
        return super().redirect_request(req, fp, code, msg, headers, newurl)


def oauth_login(home: Path) -> dict[str, Any] | None:
    auth = read_bounded_json(home / "auth.json", MAX_AUTH_BYTES)
    if not isinstance(auth, dict):
        return None
    best: dict[str, Any] | None = None
    for entry in auth.values():
        if not isinstance(entry, dict):
            continue
        mode = str(entry.get("auth_mode") or "")
        if mode not in ("oidc", "oauth", ""):
            continue
        key = str(entry.get("key") or "").strip()
        if key == "" or key.startswith("sk-") or key.startswith("xai-"):
            continue
        if best is None or str(entry.get("expires_at") or "") > str(best.get("expires_at") or ""):
            best = entry
    return best


def token_expired(login: dict[str, Any]) -> bool:
    raw = str(login.get("expires_at") or "").strip()
    if not raw:
        return False
    try:
        parsed = dt.datetime.fromisoformat(raw.replace("Z", "+00:00"))
        if parsed.tzinfo is None:
            parsed = parsed.replace(tzinfo=dt.timezone.utc)
        return parsed <= dt.datetime.now(dt.timezone.utc)
    except Exception:
        return False


def fetch_proxy_json(url: str, headers: dict[str, str]) -> dict[str, Any]:
    request = urllib.request.Request(url, headers=headers, method="GET")
    opener = urllib.request.build_opener(SameOriginRedirectHandler)
    with opener.open(request, timeout=HTTP_TIMEOUT) as response:
        final = getattr(response, "geturl", lambda: url)()
        host = urllib.parse.urlparse(final).hostname
        if host != BILLING_HOST:
            raise ValueError("redirected off the billing host")
        body = response.read(MAX_HTTP_BYTES + 1)
        if len(body) > MAX_HTTP_BYTES:
            raise ValueError("billing response too large")
        payload = json.loads(body.decode("utf-8", errors="replace"))
    if not isinstance(payload, dict):
        raise ValueError("invalid JSON object")
    return payload


def usage_percent(value: Any) -> float:
    try:
        n = float(value)
    except (TypeError, ValueError):
        return -1.0
    if n != n or n < 0:
        return -1.0
    return min(1.0, n / 100.0)


def period_label(period_type: str) -> str:
    text = str(period_type or "").upper()
    if "MONTH" in text:
        return "Monthly"
    return "Weekly"


def product_title(product: str) -> str:
    raw = str(product or "").strip()
    return PRODUCT_TITLES.get(raw, raw)


def plan_label(tier: str) -> str:
    raw = str(tier or "").strip()
    if not raw:
        return ""
    if raw in PLAN_LABELS:
        return PLAN_LABELS[raw]
    if raw.startswith("SuperGrok") and raw != "SuperGrok":
        rest = raw[len("SuperGrok"):]
        if rest and " " not in rest:
            return "SuperGrok " + rest
    return raw.replace("_", " ")


def money_cents(value: Any) -> float:
    if isinstance(value, dict):
        value = value.get("val", value.get("value", 0))
    try:
        amount = float(value or 0)
    except (TypeError, ValueError):
        return 0.0
    if amount != amount:
        return 0.0
    return max(0.0, amount / 100.0)


def parse_billing(payload: dict[str, Any]) -> dict[str, Any]:
    result: dict[str, Any] = {
        "limits": [],
        "tierLabel": "",
        "usageStatusText": "",
        "authHelpText": "",
        "balance": None,
    }
    config = payload.get("config") if isinstance(payload.get("config"), dict) else payload
    if not isinstance(config, dict):
        config = {}

    percent = usage_percent(config.get("creditUsagePercent"))
    period = config.get("currentPeriod") if isinstance(config.get("currentPeriod"), dict) else {}
    reset = str((period or {}).get("end") or config.get("billingPeriodEnd") or "")
    if percent >= 0:
        result["limits"].append({
            "label": f"{period_label(str((period or {}).get('type') or ''))} (7-day)",
            "title": period_label(str((period or {}).get("type") or "")),
            "percent": percent,
            "resetsAt": reset,
        })

    rows = config.get("productUsage") if isinstance(config.get("productUsage"), list) else []
    products: dict[str, dict[str, Any]] = {}
    for entry in rows:
        if not isinstance(entry, dict):
            continue
        title = product_title(str(entry.get("product") or ""))
        if title not in PRODUCT_ORDER:
            continue
        product_percent = usage_percent(entry.get("usagePercent"))
        if product_percent < 0:
            continue
        products[title] = {
            "label": title,
            "title": title,
            "percent": product_percent,
            "resetsAt": reset,
        }
    for title in PRODUCT_ORDER:
        if title in products:
            result["limits"].append(products[title])

    prepaid = money_cents(config.get("prepaidBalance"))
    cap = money_cents(config.get("onDemandCap"))
    spent = money_cents(config.get("onDemandUsed"))
    remaining = prepaid + max(0.0, cap - spent)
    funded = prepaid + cap
    if remaining > 0 or funded > 0:
        result["balance"] = {
            "remaining": remaining,
            "funded": funded,
            "spent": spent,
            "currency": "USD",
        }

    result["tierLabel"] = plan_label(
        str(
            payload.get("subscription_tier")
            or payload.get("subscriptionTier")
            or config.get("subscriptionTier")
            or config.get("subscription_tier")
            or ""
        )
    )
    return result


def usable_cached_limits(cached: dict[str, Any]) -> list[dict[str, Any]]:
    entries = cached.get("limits")
    return entries if isinstance(entries, list) else []


def retry_after_seconds(headers: Any) -> int:
    """Seconds a 429 asks us to wait: Retry-After when it is a plain number,
    never less than RATE_LIMIT_SECONDS nor more than an hour."""
    raw = ""
    try:
        raw = str(headers.get("Retry-After") or "").strip() if headers is not None else ""
    except Exception:
        raw = ""
    wait = int(raw) if raw.isdigit() and len(raw) <= 6 else 0
    return max(RATE_LIMIT_SECONDS, min(MAX_RATE_LIMIT_SECONDS, wait))


def collect_limits(home: Path, force: bool) -> dict[str, Any]:
    result: dict[str, Any] = {
        "limits": [],
        "tierLabel": "",
        "usageStatusText": "",
        "authHelpText": AUTH_HELP,
        "balance": None,
    }
    try:
        probe_cache: Path | None = cache_root() / "grok-limits.json"
    except OSError:
        probe_cache = None
    cached = (read_bounded_json(probe_cache, MAX_CACHE_BYTES) if probe_cache else None) or {}
    fallback = usable_cached_limits(cached)
    fallback_tier = str(cached.get("tierLabel") or "")
    fallback_balance = cached.get("balance") if isinstance(cached.get("balance"), dict) else None
    # Cached limits served under a status (sign-in expired, API down) are only
    # as fresh as this; main() passes it on so the panel can say so.
    fetched_ms = number(cached.get("fetchedAtMs"))
    if fallback and fetched_ms > 0:
        result["limitsAsOf"] = dt.datetime.fromtimestamp(fetched_ms / 1000, dt.timezone.utc).isoformat()

    login = oauth_login(home)
    if login is None:
        if fallback:
            result["limits"] = fallback
            result["tierLabel"] = fallback_tier
            result["balance"] = fallback_balance
            result["usageStatusText"] = "Sign-in missing"
        else:
            result["usageStatusText"] = "Waiting for auth"
        return result

    # Expired sign-ins do not fix themselves in 30 seconds, so no quick
    # retry is advised; the normal refresh picks up a new login.
    if token_expired(login):
        result["limits"] = fallback
        result["tierLabel"] = fallback_tier
        result["balance"] = fallback_balance
        result["usageStatusText"] = "Sign-in expired"
        result["authHelpText"] = AUTH_HELP
        return result

    token = str(login.get("key") or "").strip()
    headers = {
        "Authorization": "Bearer " + token,
        "X-XAI-Token-Auth": TOKEN_AUTH,
        "Accept": "application/json",
        "User-Agent": "xai-grok-cli",
    }
    user_id = str(login.get("user_id") or "").strip()
    if user_id:
        headers["x-userid"] = user_id

    # A 429 earlier: the host asked to be left alone, so even a forced
    # refresh waits, and no quick retry is advised.
    backoff_until = number(cached.get("backoffUntilMs")) / 1000.0
    if backoff_until > time.time():
        result["limits"] = fallback
        result["tierLabel"] = fallback_tier
        result["balance"] = fallback_balance
        result["authHelpText"] = ""
        minutes = max(1, round((backoff_until - time.time()) / 60))
        result["usageStatusText"] = f"Rate limited, next try in {minutes}m"
        return result

    if not force:
        fetched_at = number(cached.get("fetchedAtMs")) / 1000.0
        if fetched_at and 0 <= time.time() - fetched_at < PROBE_MIN_INTERVAL_SECONDS and fallback:
            result["limits"] = fallback
            result["tierLabel"] = fallback_tier
            result["balance"] = fallback_balance
            result["authHelpText"] = ""
            return result

    try:
        payload = fetch_proxy_json(BILLING_URL, headers)
    except urllib.error.HTTPError as error:
        if error.code == 429:
            wait = retry_after_seconds(error.headers)
            if probe_cache is not None:
                try:
                    write_json(probe_cache, {**cached, "backoffUntilMs": round((time.time() + wait) * 1000)})
                except OSError:
                    pass
            result["limits"] = fallback
            result["tierLabel"] = fallback_tier
            result["balance"] = fallback_balance
            result["authHelpText"] = ""
            result["usageStatusText"] = f"Rate limited, next try in {max(1, round(wait / 60))}m"
            return result
        if error.code in (401, 403):
            result["limits"] = fallback
            result["tierLabel"] = fallback_tier
            result["balance"] = fallback_balance
            result["usageStatusText"] = "Sign-in expired"
            return result
        result["limits"] = fallback
        result["tierLabel"] = fallback_tier
        result["balance"] = fallback_balance
        result["usageStatusText"] = "Grok limits unavailable"
        result["retryAdvised"] = True
        return result
    except Exception:
        result["limits"] = fallback
        result["tierLabel"] = fallback_tier
        result["balance"] = fallback_balance
        result["usageStatusText"] = "Grok limits unavailable"
        result["retryAdvised"] = True
        return result

    parsed = parse_billing(payload)
    if not parsed.get("tierLabel"):
        try:
            user = fetch_proxy_json(USER_URL, headers)
            parsed["tierLabel"] = plan_label(str(user.get("subscriptionTier") or user.get("subscription_tier") or ""))
        except Exception:
            parsed["tierLabel"] = fallback_tier

    result.update(parsed)
    result["authHelpText"] = ""
    if probe_cache is not None:
        try:
            write_json(probe_cache, {
                "fetchedAtMs": round(time.time() * 1000),
                "limits": result["limits"],
                "tierLabel": result["tierLabel"],
                "balance": result["balance"],
            })
        except OSError:
            pass
    return result


def main() -> int:
    parser = argparse.ArgumentParser(description="Print the Grok usage record as JSON")
    parser.add_argument("--force", action="store_true")
    parser.add_argument("--limits-only", action="store_true")
    parser.add_argument("--cache-seconds", type=float, default=20)
    args = parser.parse_args()

    home = grok_home()
    scan_age = 0 if args.force else (900 if args.limits_only else args.cache_seconds)
    stats = cached_scan(home / "sessions", scan_age)
    limits = collect_limits(home, args.force)
    has_data = number(stats.get("totalPrompts")) > 0 or number(stats.get("totalSessions")) > 0
    has_limits = len(limits["limits"]) > 0 or limits.get("balance") is not None

    record = {
        "schemaVersion": 1,
        "id": AGENT_ID,
        "name": AGENT_NAME,
        "updatedAt": dt.datetime.now(dt.timezone.utc).isoformat(),
        "ready": has_data or has_limits,
        "hasLocalStats": True,
        "hasPromptStats": True,
        "tierLabel": limits["tierLabel"],
        "usageStatusText": limits["usageStatusText"],
        "authHelpText": limits["authHelpText"],
        "limits": limits["limits"],
    }
    if limits.get("retryAdvised"):
        record["retryAdvised"] = True
    if limits["usageStatusText"] and limits["limits"] and limits.get("limitsAsOf"):
        record["limitsAsOf"] = limits["limitsAsOf"]
    if limits.get("balance") is not None:
        record["balance"] = limits["balance"]
    record.update(stats)
    print(json.dumps(record, separators=(",", ":"), sort_keys=True))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
